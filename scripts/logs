#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2025-2026
#
# Tail the compose stack's logs. Forwards any extra arguments to
# `docker compose logs` (e.g., a service name).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="$(cd "$SCRIPT_DIR/.." && pwd)"

exec docker compose -f "$PREFIX/compose.yaml" logs -f "$@"
