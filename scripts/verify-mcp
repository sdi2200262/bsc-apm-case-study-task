#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) BSc APM Case Study 2025-2026
#
# Verify that an eclass-mcp-server checkout authenticates against this
# mock environment using its .env and certs/. Walks the full auth
# lifecycle: authstatus (expect not authed), login, authstatus (expect
# authed), get_courses, logout, authstatus (expect not authed). Each
# transition asserts a real wiring property. Exits 0 on success,
# prints a structured error and exits non-zero on failure. The script
# never prints the fetched courses or any other application data.
#
# The check is meaningful only against the case-study's pinned baseline
# of eclass-mcp-server (commit dbd2d16) with no tracked-file changes:
# the wiring is being verified against the known-good auth code, not
# against in-progress session work. The script refuses to run if HEAD
# is not at the pinned commit or tracked files have been modified, so
# its intended use is at initial setup and after a between-sessions
# reset.

set -euo pipefail

EXPECTED_COMMIT="dbd2d16"

MCP_ROOT=""

usage() {
  cat <<'EOF'
Usage: ./scripts/verify-mcp --mcp-root <path>

Required:
  --mcp-root <path>  Path to the participant's eclass-mcp-server checkout.
                     The directory must contain .env and certs/ as copied
                     from this mock environment's prefix.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mcp-root) MCP_ROOT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "verify-mcp: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -z "$MCP_ROOT" ]]; then
  echo "verify-mcp: --mcp-root is required" >&2
  usage >&2
  exit 2
fi

if [[ ! -d "$MCP_ROOT" ]]; then
  echo "verify-mcp: --mcp-root does not point at a directory: $MCP_ROOT" >&2
  exit 2
fi

if [[ ! -f "$MCP_ROOT/.env" ]]; then
  echo "verify-mcp: .env not found at $MCP_ROOT/.env (copy <mock>/.env first)" >&2
  exit 2
fi

if [[ ! -d "$MCP_ROOT/certs" ]]; then
  echo "verify-mcp: certs/ not found at $MCP_ROOT/certs (copy <mock>/certs/ first)" >&2
  exit 2
fi

cd "$MCP_ROOT"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "verify-mcp: $MCP_ROOT is not a git checkout" >&2
  exit 2
fi

HEAD_SHA="$(git rev-parse HEAD 2>/dev/null || true)"
if [[ -z "$HEAD_SHA" ]]; then
  echo "verify-mcp: $MCP_ROOT has no commits; cannot verify baseline" >&2
  exit 2
fi
if [[ "$HEAD_SHA" != ${EXPECTED_COMMIT}* ]]; then
  echo "verify-mcp: HEAD is at ${HEAD_SHA:0:7}, expected $EXPECTED_COMMIT (the case-study pinned baseline). Run only at initial setup or after a between-sessions reset." >&2
  exit 2
fi

if ! git diff --quiet HEAD; then
  echo "verify-mcp: tracked files in $MCP_ROOT differ from $EXPECTED_COMMIT. The script verifies wiring against the baseline auth code only; reset to the pinned baseline before running." >&2
  exit 2
fi

uv run python - <<'PY'
import os
import sys
from dotenv import load_dotenv

load_dotenv()

try:
    from eclass_mcp_server.server import SessionState
    from eclass_mcp_server.authentication import attempt_login, perform_logout
    from eclass_mcp_server.course_management import get_courses
except ImportError as exc:
    print(f"verify-mcp: could not import eclass_mcp_server ({exc}); is `uv sync` complete?", file=sys.stderr)
    sys.exit(3)

username = os.environ.get("ECLASS_USERNAME")
password = os.environ.get("ECLASS_PASSWORD")
if not username or not password:
    print("verify-mcp: ECLASS_USERNAME or ECLASS_PASSWORD missing from .env", file=sys.stderr)
    sys.exit(2)

state = SessionState()

if state.is_session_valid():
    print("verify-mcp: authstatus before login reported authenticated; expected not authenticated", file=sys.stderr)
    sys.exit(1)

ok, err = attempt_login(state, username, password)
if not ok:
    print(f"verify-mcp: login failed: {err}", file=sys.stderr)
    sys.exit(1)

if not state.is_session_valid():
    print("verify-mcp: authstatus after login reported not authenticated; expected authenticated", file=sys.stderr)
    sys.exit(1)

ok, msg, _courses = get_courses(state)
if not ok:
    print(f"verify-mcp: get_courses failed: {msg}", file=sys.stderr)
    sys.exit(1)

ok, err_or_user = perform_logout(state)
if not ok:
    print(f"verify-mcp: logout failed: {err_or_user}", file=sys.stderr)
    sys.exit(1)

if state.is_session_valid():
    print("verify-mcp: authstatus after logout reported authenticated; expected not authenticated", file=sys.stderr)
    sys.exit(1)

print("wiring ok")
PY
